# Google Sheets Configuration
# The ID is the long string in your Google Sheet URL: 
# https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SHEET_ID=

# Email of your Service Account from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY=

# App Secrets
JWT_SECRET=fintrack-modern-secure-secret-key
GEMINI_API_KEY=
